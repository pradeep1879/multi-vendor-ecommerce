# Dependencies and generated output
**/node_modules/
**/dist/
**/generated/
**/build/
coverage/
*.tsbuildinfo

# Environment files: examples are safe to commit
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# Frontend runtime endpoints are public build-time config, safe to version.
!frontend/.env.development
!frontend/.env.production

# Logs, caches, and editor/OS files
*.log
.eslintcache
.cache/
.DS_Store
.idea/
.vscode/
