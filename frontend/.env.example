# Browser-safe values only. Local uses the Vite proxy; production uses the public API URL.
VITE_API_URL=/api/v1
VITE_DEV_API_URL=http://localhost:3000
# Public Google OAuth client ID (never place a client secret in this file).
VITE_GOOGLE_CLIENT_ID=
# Keep browser origin aligned with CORS_ORIGINS and the Google OAuth origin.
VITE_LOCAL_ORIGIN=http://localhost:5173
