{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "build": "DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build DIRECT_URL= bun run db:generate && bun build src/server.ts --target=bun --outdir=dist --minify",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db": "bun test src/infrastructure/database/database.integration.test.ts",
    "test:auth": "bun test src/modules/auth/auth.integration.test.ts",
    "db:generate": "bunx --bun prisma generate && bun build src/prisma-client/client.ts --target=node --outfile=src/prisma-client/client.runtime.js --external @prisma/client/runtime/client",
    "db:validate": "bunx --bun prisma validate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:status": "bunx --bun prisma migrate status",
    "db:seed": "bunx --bun prisma db seed",
    "search:reindex": "bun src/modules/catalog/search.cli.ts reindex",
    "search:worker": "bun src/modules/catalog/search.cli.ts worker",
    "orders:expire-reservations": "bun src/modules/orders/orders-expire.cli.ts",
    "payments:reconcile": "bun src/modules/payments/reconcile.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie": "1.0.2",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/cookie": "1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
