NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
# For Neon, keep DATABASE_URL pooled for application connections and set this
# to the direct (non-pooler) Neon connection string for Prisma CLI migrations.
# DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
DEV_SEED_PASSWORD=replace-with-a-local-only-password
# Optional account-specific local seed passwords; each must contain 12+ characters.
# Unset values inherit DEV_SEED_PASSWORD.
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_VENDOR_ONE_PASSWORD=
DEV_SEED_VENDOR_TWO_PASSWORD=
DEV_SEED_CUSTOMER_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# OAuth audience used to verify Google ID tokens; OAuth client secret is not needed by this flow.
# GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
# Auth email delivery uses Resend when configured; local development may explicitly log links.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Shop <accounts@example.com>
# AUTH_EMAIL_DELIVERY=console
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
AUTH_RATE_LIMIT_MAX=10
# Configure all S3 variables together to enable product image uploads.
# Keep credentials private and use a public CDN or bucket base URL for image display.
S3_ENDPOINT="https://s3.eu-north-1.amazonaws.com"
S3_BUCKET="replace-with-your-bucket"
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=replace-with-your-access-key
S3_SECRET_ACCESS_KEY=replace-with-your-secret-key
S3_PUBLIC_BASE_URL="https://cdn.example.com"
S3_PRESIGNED_UPLOAD_TTL_SECONDS=300
S3_MAX_IMAGE_BYTES=10485760
# Optional Elasticsearch endpoint; PostgreSQL search is used when unset.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Optional Redis cache; PostgreSQL remains the durable cart source.
REDIS_URL=redis://localhost:6379
REDIS_CART_TTL_SECONDS=86400

# Payments stay disabled until explicitly configured. `test` is a local adapter only.
PAYMENT_PROVIDER=disabled
# PAYMENT_PROVIDER=test requires a unique 32+ character local-only secret.
# PAYMENT_TEST_SECRET=
# PAYMENT_PROVIDER=razorpay requires test-mode credentials and webhook secret.
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
